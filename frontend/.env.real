# `bun run dev --mode real`: frontend contra el backend local (FastAPI en :8000) vía el proxy de Vite.
VITE_USE_MOCK=false
VITE_API_URL=/api
BACKEND_URL=http://localhost:8000

# Piezas que el backend ya implementa: van al backend real, no al mock en memoria.
VITE_TEMPORAL_NOTIFICACIONES=false
VITE_TEMPORAL_BUSQUEDA=false
VITE_TEMPORAL_USUARIOS_POR_ID=false
VITE_TEMPORAL_REPOSTS=false
# Las cuentas del seed del mock no existen en la base real.
VITE_TEMPORAL_DEV_CUENTAS=false
# Videos y likes/comentarios de ítems de álbum: ya los guarda el backend.
VITE_TEMPORAL_ALBUM_VIDEO=false
VITE_TEMPORAL_ALBUM_SOCIAL=false
